+package com.example.util
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.BitmapFactory
+import android.net.Uri
+import android.util.Log
+import androidx.exifinterface.media.ExifInterface
+
+/**
+ * Pemuat gambar yang aman memori + sadar orientasi EXIF.
+ *
+ * Perbaikan penting: versi lama memakai `BitmapFactory.decodeStream(stream)` langsung, yang
+ * (1) memuat foto 12 MP penuh ke memori sehingga rawan OOM, dan
+ * (2) mengabaikan orientasi EXIF sehingga foto hasil kamera terbaca miring/terbalik.
+ * OCR/AI pada naskah miring hampir selalu gagal - inilah salah satu penyebab
+ * "tidak bisa membaca teks gundul".
+ */
+object ImageLoader {
+
+    private const val TAG = "ImageLoader"
+
+    /**
+     * Decode gambar dari [uri] dengan downsampling ke sekitar [maxSide] px,
+     * lalu diputar sesuai EXIF.
+     */
+    fun decodeFromUri(context: Context, uri: Uri, maxSide: Int = 2048): Bitmap? {
+        val resolver = context.contentResolver
+
+        // 1. Baca dimensi tanpa memuat piksel.
+        val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+        runCatching {
+            resolver.openInputStream(uri)?.use { BitmapFactory.decodeStream(it, null, bounds) }
+        }
+
+        var sample = 1
+        val longest = maxOf(bounds.outWidth, bounds.outHeight)
+        if (longest > 0) {
+            while (longest / (sample * 2) >= maxSide) {
+                sample *= 2
+            }
+        }
+
+        // 2. Decode dengan inSampleSize.
+        val opts = BitmapFactory.Options().apply {
+            inSampleSize = sample.coerceAtLeast(1)
+            inPreferredConfig = Bitmap.Config.ARGB_8888
+        }
+        val raw = runCatching {
+            resolver.openInputStream(uri)?.use { BitmapFactory.decodeStream(it, null, opts) }
+        }.getOrNull() ?: run {
+            Log.e(TAG, "Gagal men-decode gambar dari $uri")
+            return null
+        }
+
+        // 3. Koreksi orientasi EXIF.
+        val degrees = runCatching {
+            resolver.openInputStream(uri)?.use {
+                ImagePreprocessor.exifOrientationDegrees(ExifInterface(it))
+            }
+        }.getOrNull() ?: 0f
+
+        val rotated = if (degrees != 0f) ImagePreprocessor.rotate(raw, degrees) else raw
+        if (rotated !== raw && !raw.isRecycled) raw.recycle()
+
+        // 4. Batasi ukuran akhir.
+        val scaled = ImagePreprocessor.scaleDown(rotated, maxSide)
+        if (scaled !== rotated && !rotated.isRecycled) rotated.recycle()
+        return scaled
+    }
+}
