+                geminiApiKey = prefs[Keys.API_KEY].orEmpty(),
+                ocrEngine = prefs[Keys.OCR_ENGINE] ?: OcrEngine.AUTO,
+                arabicTextSizeSp = prefs[Keys.ARABIC_SIZE] ?: 22f,
+                ttsSpeed = prefs[Keys.TTS_SPEED] ?: 0.85f,
+                gandulStyle = prefs[Keys.GANDUL_STYLE] ?: true,
+                autoSaveHistory = prefs[Keys.AUTO_SAVE] ?: false
+            )
+        }
+
+    suspend fun setApiKey(key: String) {
+        context.garshuniDataStore.edit { it[Keys.API_KEY] = key.trim() }
+    }
+
+    suspend fun setOcrEngine(engine: String) {
+        context.garshuniDataStore.edit { it[Keys.OCR_ENGINE] = engine }
+    }
+
+    suspend fun setArabicTextSize(size: Float) {
+        context.garshuniDataStore.edit { it[Keys.ARABIC_SIZE] = size }
+    }
+
+    suspend fun setTtsSpeed(speed: Float) {
+        context.garshuniDataStore.edit { it[Keys.TTS_SPEED] = speed }
+    }
+
+    suspend fun setGandulStyle(enabled: Boolean) {
+        context.garshuniDataStore.edit { it[Keys.GANDUL_STYLE] = enabled }
+    }
+
+    suspend fun setAutoSaveHistory(enabled: Boolean) {
+        context.garshuniDataStore.edit { it[Keys.AUTO_SAVE] = enabled }
+    }
+}
