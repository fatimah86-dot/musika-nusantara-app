+            pixels[i] = if (gray < threshold) 0xFF000000.toInt() else 0xFFFFFFFF.toInt()
         }
 
         output.setPixels(pixels, 0, width, 0, 0, width, height)
         return output
     }
+
+    /**
+     * Memperbesar foto naskah beresolusi rendah agar goresan huruf hijaiyah punya cukup
+     * kerapatan piksel untuk OCR. Bila sisi terpanjang sudah >= [minSide], bitmap dikembalikan apa adanya.
+     */
+    fun upscaleForOcr(source: Bitmap, minSide: Int = 1600, maxSide: Int = 4096): Bitmap {
+        val longest = maxOf(source.width, source.height)
+        if (longest <= 0 || longest >= minSide) return source
+        val rawRatio = minSide.toFloat() / longest.toFloat()
+        val cappedLongest = ((longest * rawRatio).toInt()).coerceAtMost(maxSide)
+        val ratio = cappedLongest.toFloat() / longest.toFloat()
+        val w = ((source.width * ratio).toInt()).coerceAtLeast(1)
+        val h = ((source.height * ratio).toInt()).coerceAtLeast(1)
+        return Bitmap.createScaledBitmap(source, w, h, true)
+    }
+
+    /**
+     * Memperkecil bitmap (hemat memori + hemat kuota API). Mengembalikan bitmap yang sama
+     * bila ukurannya sudah di bawah [maxSide].
+     */
+    fun scaleDown(source: Bitmap, maxSide: Int = 2048): Bitmap {
+        val longest = maxOf(source.width, source.height)
+        if (longest <= maxSide || longest <= 0) return source
+        val ratio = maxSide.toFloat() / longest.toFloat()
+        val w = ((source.width * ratio).toInt()).coerceAtLeast(1)
+        val h = ((source.height * ratio).toInt()).coerceAtLeast(1)
+        return Bitmap.createScaledBitmap(source, w, h, true)
+    }
+
+    /** Memutar bitmap sesuai derajat EXIF. */
+    fun rotate(source: Bitmap, degrees: Float): Bitmap {
+        if (degrees == 0f) return source
+        val matrix = Matrix().apply { postRotate(degrees) }
+        return Bitmap.createBitmap(source, 0, 0, source.width, source.height, matrix, true)
+    }
+
+    /**
+     * Mengonversi tag orientasi EXIF menjadi derajat putar.
+     * Tanpa ini, foto hasil kamera HP sering terbaca "miring" sehingga OCR gagal total.
+     */
+    fun exifOrientationDegrees(exif: ExifInterface): Float {
+        return when (exif.getAttributeInt(
+            ExifInterface.TAG_ORIENTATION,
+            ExifInterface.ORIENTATION_NORMAL
+        )) {
+            ExifInterface.ORIENTATION_ROTATE_90 -> 90f
+            ExifInterface.ORIENTATION_ROTATE_180 -> 180f
+            ExifInterface.ORIENTATION_ROTATE_270 -> 270f
+            else -> 0f
+        }
+    }
+
+    /**
+     * Mengemas bitmap menjadi JPEG base64 untuk dikirim ke Gemini Vision.
+     * Sisi terpanjang dibatasi 1568 px (rekomendasi input gambar Gemini) agar
+     * ukuran request tetap kecil namun huruf masih terbaca.
+     */
+    fun encodeJpegBase64(source: Bitmap, maxSide: Int = 1568, quality: Int = 85): String {
+        val scaled = scaleDown(source, maxSide)
+        val stream = ByteArrayOutputStream()
+        scaled.compress(Bitmap.CompressFormat.JPEG, quality.coerceIn(30, 100), stream)
+        return Base64.encodeToString(stream.toByteArray(), Base64.NO_WRAP)
+    }
 }
