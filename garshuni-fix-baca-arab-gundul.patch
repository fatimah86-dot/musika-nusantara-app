+    fun `idgham syamsiyah memakai tanda hubung`() {
+        assertTranslit("الشَّمْسُ", "asy-syamsu")
+        assertTranslit("الصَّلَاةِ", "ash-shalaati")
+        assertTranslit("الطَّهَارَةِ", "ath-thahaarati")
+        assertTranslit("النُّورُ", "an-nuuru")
+        assertTranslit("التَّطْهِيرُ", "at-tathhiiru")
+    }
+
+    @Test
+    fun `lam bertasydid pada allati dan alladzi`() {
+        assertTranslit("الَّتِي", "allatii")
+        assertTranslit("الَّذِي", "alladzii")
+    }
+
+    @Test
+    fun `artikel qamariyah tetap al`() {
+        assertTranslit("الْقَمَرُ", "al-qamaru")
+        assertTranslit("الْمِيَاهُ", "al-miyaahu")
+    }
+
+    @Test
+    fun `tasydid digandakan di tengah kata`() {
+        assertTranslit("مُحَمَّدٌ", "muhammadun")
+        assertTranslit("بَرْهَتِيَةٍ كَرِيْرٍ", "barhatiyatin kariirin")
+    }
+
+    @Test
+    fun `ta marbuthah berbunyi t saat hidup dan h saat waqaf`() {
+        assertTranslit("خَمْسَةٌ", "khamsatun")
+        assertTranslit("الصَّلَاةُ", "ash-shalaatu")
+        assertTrue(ArabicTransliterator.transliterate("زَكَاة").endsWith("h"))
+    }
+
+    @Test
+    fun `diftong ai dan au`() {
+        assertTranslit("شَيْءٌ", "syai'un")
+        assertTranslit("بَيْتٌ", "baitun")
+        assertTranslit("قَوْلٌ", "qaulun")
+        assertTranslit("الْيَوْمَ", "al-yauma")
+    }
+
+    @Test
+    fun `hamzah pembawa tidak menghasilkan vokal ganda`() {
+        assertTranslit("أَنْ", "an")
+        assertTranslit("إِلَّا", "illaa")
+        assertTranslit("أَحْكَامِ", "ahkaami")
+        assertTranslit("مُؤْمِنٌ", "mu'minun")
+    }
+
+    @Test
+    fun `liaison tanwin dengan artikel`() {
+        assertTrue(ArabicTransliterator.transliterate("رَسُولُ اللهِ الْقَمَرُ").contains("Allaahi"))
+        assertEquals("kitaabu al-hikmati", ArabicTransliterator.transliterate("كِتَابُ الْحِكْمَةِ"))
+        assertFalse(
+            "tidak boleh ada spasi ganda",
+            ArabicTransliterator.transliterate("فَصْلٌ أَرْكَانُ").contains("  ")
+        )
+    }
+
+    @Test
+    fun `huruf jawi pegon ditransliterasikan`() {
+        val hasil = ArabicTransliterator.transliterate("ڤڠݢيلاءن")
+        assertTrue("harus dimulai p, hasilnya: $hasil", hasil.startsWith("p"))
+        assertTrue("ڠ harus menjadi ng, hasilnya: $hasil", hasil.contains("ng"))
+        assertTrue("ݢ harus menjadi g, hasilnya: $hasil", hasil.contains("g"))
+    }
+
+    @Test
+    fun `teks gundul tetap menghasilkan rangka konsonan`() {
+        val hasil = ArabicTransliterator.transliterate("فصل اركان الاسلام")
+        assertTrue("harus dimulai rangka konsonan ف ص ل, hasilnya: $hasil", hasil.startsWith("fshl"))
+        assertTrue("tanwin gundul disambung ke artikel, hasilnya: $hasil", hasil.contains("arkanal-aslam"))
+    }
+
+    @Test
+    fun `stripDiacritics membuang tasykil saja`() {
+        assertEquals(
+            "بسم الله الرحمن الرحيم",
+            ArabicTransliterator.stripDiacritics("بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ")
+        )
+    }
+
+    @Test
+    fun `validator menerima harokat setia dan menolak yang menyimpang`() {
+        val gundul = "فصل اركان الاسلام خمسة شهادة ان لا اله الا الله"
+        val setia = "فَصْلٌ أَرْكَانُ الْإِسْلَامِ خَمْسَةٌ شَهَادَةُ أَنْ لَا إِلَهَ إِلَّا اللهُ"
+        val menyimpang = "فَصْلٌ فِي أَرْكَانِ الْإِسْلَامِ الْخَمْسَةِ وَهِيَ الشَّهَادَتَانِ"
+
+        assertTrue(HarakatValidator.isFaithful(gundul, setia))
+        assertFalse(HarakatValidator.isFaithful(gundul, menyimpang))
+        assertTrue(HarakatValidator.similarity(gundul, setia) > 0.9)
+        assertTrue(HarakatValidator.similarity(gundul, menyimpang) < 0.7)
+    }
+
+    @Test
+    fun `validator mengabaikan varian huruf setara`() {
+        assertTrue(
+            HarakatValidator.similarity("محمدا رسول الله", "مُحَمَّدٌ رَسُولُ اللّٰه") > 0.85
+        )
+    }
+}
diff --git a/app/src/test/java/com/example/ScriptDetectorTest.kt b/app/src/test/java/com/example/ScriptDetectorTest.kt
new file mode 100644
index 0000000..4e5fb1d
--- /dev/null
+++ b/app/src/test/java/com/example/ScriptDetectorTest.kt
@@ -0,0 +1,78 @@
+package com.example
+
+import com.example.data.ai.ScriptDetector
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/** Uji unit deteksi aksara. Berjalan di JVM biasa (tanpa Robolectric). */
+class ScriptDetectorTest {
+
+    @Test
+    fun `asma birhatiyah terdeteksi sebagai suryani`() {
+        assertEquals(
+            ScriptDetector.TYPE_SURYANI_BIRHATIYAH,
+            ScriptDetector.detectScriptType("برهتية كرير تتلية طوران")
+        )
+        assertEquals(
+            ScriptDetector.TYPE_SURYANI_BIRHATIYAH,
+            ScriptDetector.detectScriptType("مزجل بزجل ترقب برهش")
+        )
+    }
+
+    @Test
+    fun `teks arab gundul terdeteksi sebagai arab gundul`() {
+        val analysis = ScriptDetector.analyze("فصل اركان الاسلام خمسة")
+        assertEquals(ScriptDetector.TYPE_ARAB_GUNDUL, analysis.scriptType)
+        assertTrue("teks tanpa tasykil harus dianggap gundul", analysis.isGundul)
+        assertEquals(0, analysis.harakatCount)
+    }
+
+    @Test
+    fun `teks berharokat tidak lagi dianggap gundul`() {
+        val analysis = ScriptDetector.analyze("بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ")
+        assertEquals(ScriptDetector.TYPE_ARAB_GUNDUL, analysis.scriptType)
+        assertFalse("rasio harokat tinggi berarti bukan gundul", analysis.isGundul)
+        assertTrue(analysis.harakatRatio > ScriptDetector.GUNDUL_HARAKAT_THRESHOLD)
+    }
+
+    @Test
+    fun `huruf jawi pegon nusantara dikenali`() {
+        val analysis = ScriptDetector.analyze("مڠس چاري ڽاتو")
+        assertEquals(ScriptDetector.TYPE_ARAB_GUNDUL, analysis.scriptType)
+        assertTrue("huruf Jawi/Pegon harus terhitung", analysis.isJawiPegon)
+        assertTrue(analysis.jawiPegonCount >= 3)
+    }
+
+    @Test
+    fun `teks latin tidak lagi dianggap arab gundul`() {
+        assertEquals(
+            ScriptDetector.TYPE_LATIN,
+            ScriptDetector.detectScriptType("Ini catatan pinggir berbahasa Indonesia")
+        )
+        assertEquals(0.0, ScriptDetector.arabicRatio("Ini catatan pinggir"), 0.001)
+    }
+
+    @Test
+    fun `kata hikmah saja tidak membuat teks fiqih menjadi suryani`() {
+        // Versi lama memasukkan "hikmah"/"suryani" sebagai kata kunci pemicu Birhatiyah.
+        val fiqih = "كتاب احكام الطهارة dari kitab hikmah pesantren"
+        assertEquals(ScriptDetector.TYPE_ARAB_GUNDUL, ScriptDetector.detectScriptType(fiqih))
+    }
+
+    @Test
+    fun `rasio aksara arab dihitung benar`() {
+        assertTrue(ScriptDetector.arabicRatio("فصل اركان الاسلام") > 0.8)
+        assertFalse(ScriptDetector.containsArabic("bismillah"))
+        assertTrue(ScriptDetector.containsArabic("بسم الله"))
+    }
+
+    @Test
+    fun `blok unicode suryani terdeteksi`() {
+        assertEquals(
+            ScriptDetector.TYPE_SURYANI_BIRHATIYAH,
+            ScriptDetector.detectScriptType("\u0712\u072A\u072C\u0710")
+        )
+    }
+}
