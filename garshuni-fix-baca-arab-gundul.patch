+package com.example.util
+
+import com.example.data.ai.ScriptDetector
+
+/**
+ * Transliterasi Arab -> Latin yang sadar harokat, mengikuti konvensi pesantren Indonesia
+ * (sy, sh, th, kh, ‘, diftong ai/au).
+ *
+ * Perbaikan terhadap versi lama (`generateSimpleTransliteration` di ViewModel):
+ * - versi lama membuang SEMUA harokat sehingga "فَصْلٌ" menjadi "fshl";
+ * - tasydid tidak digandakan;
+ * - hamzah (أ إ آ ؤ ئ ٱ), alif maqshurah (ى), dan tatweel (ـ) hilang;
+ * - huruf Jawi/Pegon (ڤ ڠ ݢ چ ڽ ۏ) tidak dikenal sama sekali;
+ * - tidak ada penanganan "ال" (qamariyah/syamsiyah), vokal panjang, maupun tanwin.
+ *
+ * Kelas ini murni Kotlin (tanpa Android) sehingga bisa diuji unit di JVM.
+ */
+object ArabicTransliterator {
+
+    private const val FATHAH = '\u064E'
+    private const val DHAMMAH = '\u064F'
+    private const val KASRAH = '\u0650'
+    private const val FATHATAN = '\u064B'
+    private const val DHAMMATAN = '\u064C'
+    private const val KASRATAN = '\u064D'
+    private const val SUPER_ALEF = '\u0670'
+    private const val SHADDA = '\u0651'
+    private const val SUKUN = '\u0652'
+
+    private const val ALEF = '\u0627'
+    private const val LAM = '\u0644'
+    private const val WAW = '\u0648'
+    private const val YA = '\u064A'
+    private const val YA_MAQSHURAH = '\u0649'
+    private const val TA_MARBUTHAH = '\u0629'
+    private const val AIN = '\u0639'
+    private const val HAMZAH = '\u0621'
+    private const val ALEF_HAMZA_ABOVE = '\u0623'
+    private const val ALEF_HAMZA_BELOW = '\u0625'
+    private const val ALEF_MADDA = '\u0622'
+    private const val WAW_HAMZA = '\u0624'
+    private const val YA_HAMZA = '\u0626'
+    private const val ALEF_WASLA = '\u0671'
+
+    /** Huruf syamsiyah: "ال" melebur (idgham) sehingga ل-nya tidak ditulis. */
+    private val SUN_LETTERS = setOf(
+        '\u062A', '\u062B', '\u062F', '\u0630', '\u0631', '\u0632',
+        '\u0633', '\u0634', '\u0635', '\u0636', '\u0637', '\u0638',
+        '\u0644', '\u0646'
+    )
+
+    private val HAMZA_CARRIERS = setOf(
+        ALEF_HAMZA_ABOVE, ALEF_HAMZA_BELOW, WAW_HAMZA, YA_HAMZA
+    )
+
+    private val VOWELS: Map<Char, String> = mapOf(
+        FATHAH to "a",
+        KASRAH to "i",
+        DHAMMAH to "u",
+        FATHATAN to "an",
+        KASRATAN to "in",
+        DHAMMATAN to "un",
+        SUPER_ALEF to "aa"
+    )
+
+    /** Diakritik hiasan/tanda waqaf yang tidak berbunyi sendiri. */
+    private val IGNORED: Set<Char> = setOf(
+        '\u0653', '\u0654', '\u0655', '\u0656', '\u0657', '\u0658', '\u0659',
+        '\u065A', '\u065B', '\u065C', '\u065D', '\u065E', '\u065F',
+        '\u06D6', '\u06D7', '\u06D8', '\u06D9', '\u06DA', '\u06DB', '\u06DC',
+        '\u06DF', '\u06E0', '\u06E1', '\u06E2', '\u06E3', '\u06E4',
+        '\u06E7', '\u06E8', '\u06EA', '\u06EB', '\u06EC', '\u06ED',
+        '\u0640' // tatweel
+    )
+
+    private val LETTERS: Map<Char, String> = mapOf(
+        '\u0628' to "b",      // ب
+        '\u062A' to "t",      // ت
+        '\u062B' to "ts",     // ث
+        '\u062C' to "j",      // ج
+        '\u062D' to "h",      // ح
+        '\u062E' to "kh",     // خ
+        '\u062F' to "d",      // د
+        '\u0630' to "dz",     // ذ
+        '\u0631' to "r",      // ر
+        '\u0632' to "z",      // ز
+        '\u0633' to "s",      // س
+        '\u0634' to "sy",     // ش
+        '\u0635' to "sh",     // ص
+        '\u0636' to "dh",     // ض
+        '\u0637' to "th",     // ط
+        '\u0638' to "zh",     // ظ
+        AIN to "\u2018",      // ع
+        '\u063A' to "gh",     // غ
+        '\u0641' to "f",      // ف
+        '\u0642' to "q",      // ق
+        '\u0643' to "k",      // ك
+        LAM to "l",           // ل
+        '\u0645' to "m",      // م
+        '\u0646' to "n",      // ن
+        '\u0647' to "h",      // ه
+        WAW to "w",           // و
+        YA to "y",            // ي
+        YA_MAQSHURAH to "aa", // ى
+        ALEF to "a",          // ا
+        ALEF_WASLA to "a",    // ٱ
+        HAMZAH to "'",        // ء
+        // Jawi / Pegon Nusantara
+        '\u06A4' to "p",      // ڤ
+        '\u067E' to "p",      // پ
+        '\u06A0' to "ng",     // ڠ
+        '\u06AC' to "ng",     // ڬ
+        '\u06AE' to "g",      // ڮ
+        '\u0762' to "g",      // ݢ
+        '\u0686' to "c",      // چ
+        '\u0683' to "j",      // ڃ
+        '\u06BD' to "ny",     // ڽ
+        '\u06CF' to "v",      // ۏ
+        '\u06BB' to "n",      // ڻ
+        '\u06CC' to "y",      // ی
+        '\u06D2' to "e",      // ے
+        '\u06BE' to "h",      // ھ
+        '\u06A9' to "k",      // ک
+        '\u06AF' to "g",      // گ
+        '\u0681' to "z"       // ځ
+    )
+
+    /** Bentuk lafazh yang lazim ditulis khusus. */
+    private val SPECIAL_WORDS: Map<String, String> = mapOf(
+        "\u0627\u0644\u0644\u0647" to "Allaah",        // الله
+        "\u0644\u0644\u0647" to "Lillaah",             // لله
+        "\u0628\u0627\u0644\u0644\u0647" to "Billaah", // بالله
+        "\u0648\u0627\u0644\u0644\u0647" to "Wallaah"  // والله
+    )
+
+    /** Hasil pemindaian tasykil yang menempel pada sebuah huruf. */
+    private data class Tashkil(
+        val vowel: String,
+        val shadda: Boolean,
+        val sukun: Boolean,
+        val nextIndex: Int
+    )
+
+    private fun scan(chars: CharArray, start: Int): Tashkil {
+        var j = start
+        var vowel = ""
+        var shadda = false
+        var sukun = false
+        while (j < chars.size) {
+            val c = chars[j]
+            when {
+                c == SHADDA -> { shadda = true; j++ }
+                c == SUKUN -> { sukun = true; j++ }
+                c in IGNORED -> j++
+                VOWELS.containsKey(c) -> {
+                    // Fathah berdiri (U+0670) menandakan vokal panjang meski ada fathah biasa.
+                    if (c == SUPER_ALEF || vowel.isEmpty()) vowel = VOWELS.getValue(c)
+                    j++
+                }
+                else -> return Tashkil(vowel, shadda, sukun, j)
+            }
+        }
+        return Tashkil(vowel, shadda, sukun, j)
+    }
+
+    /**
+     * Transliterasi teks (biasanya teks berharokat). Teks gundul tanpa harokat tetap
+     * menghasilkan rangka konsonan - karena itu untuk naskah gundul, transliterasi diambil
+     * dari versi berharokatnya.
+     */
+    fun transliterate(text: String): String {
+        if (text.isBlank()) return ""
+        val out = StringBuilder()
+        val token = StringBuilder()
+        var previousLatin = ""
+        var previousWasArabic = false
+        var pendingSeparator: Char? = null
+
+        fun endsWithTanwin(latin: String): Boolean =
+            latin.endsWith("an") || latin.endsWith("in") || latin.endsWith("un")
+
+        fun startsWithArticle(original: String): Boolean =
+            original.length >= 2 && original[0] == ALEF && original[1] == LAM
+
+        fun flushToken() {
+            if (token.isEmpty()) return
+            val original = token.toString()
+            val latin = transliterateWord(original)
+
+            // Liaison: tanwin bertemu "ال" ditulis sambung (arkan + al-aslam -> arkanal-aslam).
+            val merge = pendingSeparator == ' ' &&
+                previousWasArabic &&
+                endsWithTanwin(previousLatin) &&
+                startsWithArticle(original)
+
+            val separator = pendingSeparator
+            if (separator != null && !merge) out.append(separator)
+            out.append(latin)
+
+            previousLatin = latin
+            previousWasArabic = ScriptDetector.containsArabic(original)
+            token.setLength(0)
+            pendingSeparator = null
+        }
+
+        for (ch in text) {
+            if (ch.isWhitespace()) {
+                flushToken()
+                pendingSeparator = if (pendingSeparator == '\n' || ch == '\n') '\n' else ' '
+            } else {
+                token.append(ch)
+            }
+        }
+        flushToken()
+
+        return tidy(out.toString())
+    }
+
+    private fun transliterateWord(word: String): String {
+        val chars = word.toCharArray()
+        val skeleton = stripDiacritics(word)
+
+        SPECIAL_WORDS[skeleton]?.let { base ->
+            return base + trailingVowel(chars)
+        }
+
+        val out = StringBuilder()
+        var i = 0
+        var lastVowel = ""
+        var assimilated = false
+
+        // --- Artikel "ال" di awal kata ---
+        if (chars.size > 2 && chars[0] == ALEF && chars[1] == LAM) {
+            val lam = scan(chars, 2)
+            when {
+                // الّ : lam-nya bertasydid (mis. الَّتِي، الَّذِي) -> "all(a)"
+                lam.shadda -> {
+                    out.append("all").append(lam.vowel)
+                    lastVowel = lam.vowel.ifEmpty { lastVowel }
+                    i = lam.nextIndex
+                }
+
+                lam.nextIndex < chars.size -> {
+                    val nextLetter = chars[lam.nextIndex]
+                    val nextTashkil = scan(chars, lam.nextIndex + 1)
+                    if (lam.vowel.isEmpty() && nextTashkil.shadda && nextLetter in SUN_LETTERS) {
+                        // Idgham syamsiyah: ar-, as-, asy-, at-, an-, al-l...
+                        out.append("a")
+                        assimilated = true
+                    } else {
+                        out.append("al-")
+                    }
+                    i = lam.nextIndex
+                }
+            }
+        }
+
+        while (i < chars.size) {
+            val ch = chars[i]
+
+            if (ch in IGNORED || ch == SHADDA || ch == SUKUN) {
+                i++
+                continue
+            }
+            if (VOWELS.containsKey(ch)) {
+                out.append(VOWELS.getValue(ch))
+                lastVowel = VOWELS.getValue(ch)
+                i++
+                continue
+            }
+
+            val tashkil = scan(chars, i + 1)
+            val next = if (tashkil.nextIndex < chars.size) chars[tashkil.nextIndex] else null
+            var consumed = tashkil.nextIndex
+            var vowel = tashkil.vowel
+            val base: String
+
+            when {
+                ch == TA_MARBUTHAH ->
+                    // ta' marbuthah berbunyi "t" bila hidup (diteruskan), "h" bila waqaf.
+                    base = if (vowel.isNotEmpty() || tashkil.shadda) "t" else "h"
+
+                ch == ALEF_HAMZA_ABOVE || ch == ALEF_HAMZA_BELOW || ch == ALEF_WASLA ->
+                    // alif hanya "pembawa" hamzah: bunyinya datang dari harokatnya.
+                    base = if (vowel.isNotEmpty()) "" else if (ch == ALEF_HAMZA_BELOW) "i" else "a"
+
+                ch == ALEF_MADDA -> base = "aa"
+
+                ch == WAW_HAMZA || ch == YA_HAMZA ->
+                    base = if (vowel.isNotEmpty() || tashkil.sukun || tashkil.shadda) "'"
+                    else if (ch == WAW_HAMZA) "u" else "i"
+
+                // ya' sukun setelah fathah/kasrah = diftong "ai" atau vokal panjang "ii",
+                // kecuali sebelum alif (مِيَاه) atau ta' marbuthah (بَرْهَتِيَة).
+                ch == YA && tashkil.sukun && vowel.isEmpty() &&
+                    (lastVowel == "a" || lastVowel == "i") &&
+                    next != ALEF && next != TA_MARBUTHAH -> base = "i"
+
+                ch == WAW && tashkil.sukun && vowel.isEmpty() &&
+                    (lastVowel == "u" || lastVowel == "a") &&
+                    next != ALEF -> base = "u"
+
+                LETTERS.containsKey(ch) -> base = LETTERS.getValue(ch)
+
+                ch.isLetterOrDigit() || isPunctuation(ch) -> {
+                    out.append(ch)
+                    i++
+                    continue
+                }
+
+                else -> {
+                    i++
+                    continue
+                }
+            }
+
+            // Tasydid: huruf digandakan. Setelah idgham syamsiyah diberi tanda hubung
+            // (ar-rahmaan, asy-syams, ath-thahaarah).
+            if (tashkil.shadda) {
+                out.append(base)
+                if (assimilated) out.append('-')
+            }
+            out.append(base)
+            assimilated = false
+
+            // Vokal panjang: harokat + huruf mad yang tidak berharokat sendiri.
+            val nextTashkil = if (consumed < chars.size) scan(chars, consumed + 1)
+            else Tashkil("", false, false, consumed)
+            when {
+                (vowel == "a" || vowel == "an") && (next == ALEF || next == YA_MAQSHURAH) &&
+                    !nextTashkil.shadda -> {
+                    vowel = "aa"
+                    consumed = nextTashkil.nextIndex
+                }
+
+                vowel == "u" && next == WAW && nextTashkil.vowel.isEmpty() &&
+                    !nextTashkil.shadda -> {
+                    vowel = "uu"
+                    consumed = nextTashkil.nextIndex
+                }
+
+                vowel == "i" && (next == YA || next == YA_MAQSHURAH) &&
+                    nextTashkil.vowel.isEmpty() && !nextTashkil.shadda -> {
+                    vowel = "ii"
+                    consumed = nextTashkil.nextIndex
+                }
+            }
+
+            out.append(vowel)
+            if (vowel.isNotEmpty()) lastVowel = vowel
+
+            // wa + hamzah -> "wa-i..." agar mudah dibaca
+            if (ch == WAW && vowel == "a" && next != null && next in HAMZA_CARRIERS) {
+                out.append('-')
+            }
+
+            i = consumed
+        }
+
+        return out.toString()
+    }
+
+    private fun trailingVowel(chars: CharArray): String {
+        for (k in chars.indices.reversed()) {
+            val c = chars[k]
+            if (VOWELS.containsKey(c)) {
+                val v = VOWELS.getValue(c)
+                return if (v == "a" || v == "i" || v == "u") v else ""
+            }
+            if (c == SHADDA || c == SUKUN || c in IGNORED) continue
+            return ""
+        }
+        return ""
+    }
+
+    /** Membuang seluruh tasykil; dipakai untuk membandingkan kerangka kata. */
+    fun stripDiacritics(text: String): String {
+        val sb = StringBuilder(text.length)
+        for (ch in text) {
+            if (VOWELS.containsKey(ch) || ch == SHADDA || ch == SUKUN || ch in IGNORED) continue
+            sb.append(ch)
+        }
+        return sb.toString()
+    }
+
+    private fun isPunctuation(ch: Char): Boolean =
+        ch == ',' || ch == '.' || ch == ':' || ch == ';' || ch == '!' || ch == '?' ||
+            ch == '-' || ch == '\'' || ch == '"' || ch == '(' || ch == ')' ||
+            ch == '\u060C' || ch == '\u061B' || ch == '\u061F' || ch == '\u06D4'
+
+    private fun tidy(text: String): String =
+        text.replace(Regex("[ \\t]+"), " ")
+            .replace(Regex(" ?\\n ?"), "\n")
+            .replace(Regex(" ([,.:;!?])"), "$1")
+            .trim()
+}
