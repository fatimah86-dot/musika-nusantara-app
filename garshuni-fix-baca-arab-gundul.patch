+package com.example.data.ai
+
+import com.example.util.ArabicTransliterator
+
+/**
+ * Penjaga mutu hasil auto-harokat.
+ *
+ * Masalah nyata pada AI: model kadang "mengarang" ulang teks (menambah/mengurangi huruf,
+ * menerjemahkan, atau menyisipkan komentar). Kelas ini membandingkan KERANGKA huruf
+ * (tulang kata tanpa tasykil) antara teks asli dan hasil berharokat, lalu memberi skor
+ * kesetiaan. Murni Kotlin sehingga bisa diuji unit.
+ */
+object HarakatValidator {
+
+    /** Ambang skor kesetiaan minimum (0.0 - 1.0). */
+    const val DEFAULT_THRESHOLD = 0.72
+
+    /** Huruf yang dianggap setara saat membandingkan kerangka kata. */
+    private val FOLD: Map<Char, Char> = mapOf(
+        '\u0623' to '\u0627', // أ
+        '\u0625' to '\u0627', // إ
+        '\u0622' to '\u0627', // آ
+        '\u0671' to '\u0627', // ٱ
+        '\u0649' to '\u064A', // ى -> ي
+        '\u06CC' to '\u064A', // ی -> ي
+        '\u0629' to '\u0647', // ة -> ه
+        '\u0624' to '\u0648', // ؤ -> و
+        '\u0626' to '\u064A', // ئ -> ي
+        '\u06A9' to '\u0643'  // ک -> ك
+    )
+
+    /** Kerangka kata: tanpa harokat, tanpa spasi/tanda baca, huruf varian disamakan. */
+    fun skeleton(text: String): String {
+        val stripped = ArabicTransliterator.stripDiacritics(text)
+        val sb = StringBuilder(stripped.length)
+        for (ch in stripped) {
+            if (ch.isWhitespace()) continue
+            if (!isWordChar(ch)) continue
+            sb.append(FOLD[ch] ?: ch)
+        }
+        return sb.toString()
+    }
+
+    private fun isWordChar(ch: Char): Boolean =
+        ScriptDetector.isArabicScriptChar(ch) ||
+            ScriptDetector.isSyriacScriptChar(ch) ||
+            (ch.isLetterOrDigit() && ch.code < 0x0250)
+
+    /** Skor kemiripan 0.0 - 1.0 berbasis jarak Levenshtein pada kerangka kata. */
+    fun similarity(original: String, vocalized: String): Double {
+        val a = skeleton(original)
+        val b = skeleton(vocalized)
+        if (a.isEmpty() && b.isEmpty()) return 1.0
+        if (a.isEmpty() || b.isEmpty()) return 0.0
+        if (a == b) return 1.0
+
+        // Potong teks sangat panjang agar hitungan tetap ringan di perangkat.
+        val limit = 4000
+        val aa = if (a.length > limit) a.substring(0, limit) else a
+        val bb = if (b.length > limit) b.substring(0, limit) else b
+
+        val distance = levenshtein(aa, bb)
+        val maxLen = maxOf(aa.length, bb.length)
+        return (1.0 - distance.toDouble() / maxLen.toDouble()).coerceIn(0.0, 1.0)
+    }
+
+    fun isFaithful(
+        original: String,
+        vocalized: String,
+        threshold: Double = DEFAULT_THRESHOLD
+    ): Boolean = similarity(original, vocalized) >= threshold
+
+    /** True bila hasil berharokat benar-benar mengandung tasykil. */
+    fun hasHarakat(text: String): Boolean = text.any { ScriptDetector.isHarakat(it) }
+
+    private fun levenshtein(a: String, b: String): Int {
+        if (a == b) return 0
+        var prev = IntArray(b.length + 1) { it }
+        var curr = IntArray(b.length + 1)
+
+        for (i in 1..a.length) {
+            curr[0] = i
+            val ca = a[i - 1]
+            for (j in 1..b.length) {
+                val cost = if (ca == b[j - 1]) 0 else 1
+                curr[j] = minOf(
+                    prev[j] + 1,        // hapus
+                    curr[j - 1] + 1,    // sisip
+                    prev[j - 1] + cost  // substitusi
+                )
+            }
+            val tmp = prev
+            prev = curr
+            curr = tmp
+        }
+        return prev[b.length]
+    }
+}
