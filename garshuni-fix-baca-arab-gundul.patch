+class SettingsRepository(private val context: Context) {
+
+    private object Keys {
+        val API_KEY = stringPreferencesKey("gemini_api_key")
+        val OCR_ENGINE = stringPreferencesKey("ocr_engine")
+        val ARABIC_SIZE = floatPreferencesKey("arabic_text_size")
+        val TTS_SPEED = floatPreferencesKey("tts_speed")
+        val GANDUL_STYLE = booleanPreferencesKey("gandul_style")
+        val AUTO_SAVE = booleanPreferencesKey("auto_save_history")
+    }
+
+    val settings: Flow<GarshuniSettings> = context.garshuniDataStore.data
+        .catch { emit(emptyPreferences()) }
+        .map { prefs ->
